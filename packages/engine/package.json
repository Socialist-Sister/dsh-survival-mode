{
  "name": "@dsh-survival/engine",
  "version": "0.14.0",
  "description": "Survival-mode rules engine: hunger/hp/day-night/mob settlement, tool gates, mining drops, per-session independent saves with file respawn points (workspace snapshot/rollback on death), and the dsh-survival settings namespace",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mount": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mount.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir lib && node -e \"require('fs').copyFileSync('lib/index.js', 'lib/index.mount.js')\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-test.mjs && node --test test-dist/game.test.mjs test-dist/respawn.test.mjs",
    "pack": "pnpm pack --pack-destination ../../dist"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.27.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}